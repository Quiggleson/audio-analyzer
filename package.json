{
  "name": "audio-analyzer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:deps": "node scripts/check-deps.mjs",
    "check:lessons": "node scripts/check-lessons.mjs",
    "verify": "npm run check:deps && npm run check:lessons && npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
